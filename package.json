{
  "name": "lucent-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Lucent staking protocol on Solana \u2014 kit-native, generated from the deployed IDL",
  "author": "Luminosity Labs",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --target es2020",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/codegen.mjs",
    "verify:codegen": "tsx scripts/verify-codegen.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "check:browser": "node scripts/browser-check.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "verify": "npm run typecheck && npm run codegen && npm run verify:codegen && npm run build && npm run check:browser && npm run check:pack && npx publint && npx attw --pack .",
    "verify:position": "tsx scripts/verify-position.ts"
  },
  "keywords": [
    "solana",
    "staking",
    "defi",
    "lucent",
    "luminosity",
    "kit"
  ],
  "peerDependencies": {
    "@solana/kit": ">=8.0.0 <9"
  },
  "dependencies": {
    "@solana/program-client-core": "^8.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@codama/cli": "^1.6.3",
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.5.0",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/program-client-core": "^8.3.0",
    "@types/node": "^20.0.0",
    "publint": "^0.3.24",
    "tsup": "^8.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sceptejas/Lucent-SDK_v0.git"
  },
  "homepage": "https://lucent.finance",
  "bugs": {
    "url": "https://github.com/sceptejas/Lucent-SDK_v0/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {}
}
