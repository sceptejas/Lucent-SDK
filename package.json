{
  "name": "lucent-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Lucent delta-neutral staking protocol on Solana",
  "author": "Luminosity Labs",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solana",
    "staking",
    "defi",
    "lucent",
    "luminosity"
  ],
  "peerDependencies": {
    "@solana/web3.js": "^1.0.0",
    "@solana/spl-token": "^0.4.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.3",
    "@types/bn.js": "^5.1.5",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
